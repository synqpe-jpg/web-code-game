# ==============================================================================
# WEB CODE GAME - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Lưu ý: Đây là file mẫu mô tả cấu trúc các biến môi trường.
# KHÔNG ĐIỀN GIÁ TRỊ THẬT VÀO FILE NÀY!
# Sao chép file này thành .env và điền thông tin tương ứng cho môi trường của bạn.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Account & Deployment Credentials
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Main Public Site Project
CLOUDFLARE_PROJECT_NAME=web-code-game
CLOUDFLARE_KV_ID=your_main_kv_namespace_id_here

# Admin Dashboard Project
CLOUDFLARE_ADMIN_PROJECT_NAME=admin-code-game-shop
CLOUDFLARE_ADMIN_KV_ID=your_admin_kv_namespace_id_here

# ------------------------------------------------------------------------------
# 2. Server & API Security Secrets (Dùng cho Edge Worker & API Authentication)
# ------------------------------------------------------------------------------
# Khóa bí mật ký mã phiên làm việc JWT (Session Token)
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here

# Khóa bí mật đồng bộ nội bộ giữa Admin và Server (/api/sync Header Auth)
ADMIN_SYNC_SECRET=your_admin_sync_secret_min_32_chars_here

# Muối băm mật khẩu thành viên (Password Pepper Salt)
PASSWORD_PEPPER=your_password_pepper_salt_string_here

# Môi trường chạy (development | production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 3. Telegram Notifications Bot (Tùy chọn)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
