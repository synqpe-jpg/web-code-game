{
  "manifest_version": 3,
  "name": "CodeGame.Shop - 1-Click Facebook Giftcode Scanner",
  "version": "1.2.0",
  "description": "Quét sâu toàn bộ bài viết, mở nút xem thêm, bóc tách link sự kiện và bắn mã từ Facebook lên web codegame.shop trong 1 chạm.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CodeGame.Shop - Quét Code Facebook"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://web-code-game.pages.dev/*",
    "https://admin-code-game-shop.pages.dev/*",
    "https://codegame.shop/*",
    "https://admin.codegame.shop/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
