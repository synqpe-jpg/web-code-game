{
  "name": "web-code-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/audit_zero_test_artifacts.cjs && node scripts/audit_news_covers.cjs && node scripts/build.cjs",
    "test:ingest": "node scripts/test_ingest_regression.cjs",
    "preview": "vite preview",
    "crawl:all": "node scripts/crawl_codemoi_and_enrich_all.cjs",
    "crawl:abei": "node scripts/fetch_abei_database.cjs",
    "sync:codes": "node scripts/sync_source_codes.cjs",
    "crawler:run": "node scripts/crawler/run_crawler.cjs",
    "crawler:googleplay": "node scripts/crawler/google_play_crawler.cjs",
    "crawler:codemoi": "node scripts/crawler/scrapers/codemoi_game_scraper.cjs",
    "crawler:games": "node scripts/crawler/sync_new_games.cjs",
    "crawler:icons": "node scripts/sync_crawler_game_icons.cjs",
    "news:auto": "node scripts/crawler/auto_news_publisher.cjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=web-code-game",
    "deploy:admin": "npm run build && wrangler pages deploy dist --project-name=admin-code-game-shop",
    "deploy:all": "npm run build && wrangler pages deploy dist --project-name=web-code-game && wrangler pages deploy dist --project-name=admin-code-game-shop",
    "backup": "node scripts/export_full_database_backup.cjs",
    "cap:icons": "node scripts/generate_android_icons.cjs",
    "cap:sync": "npx cap sync",
    "cap:build": "node scripts/generate_android_icons.cjs && node scripts/build.cjs && npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.6",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.141.0"
  }
}
